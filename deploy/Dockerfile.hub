FROM node:22-alpine AS web-builder
RUN corepack enable
WORKDIR /src/web
COPY web/package.json web/pnpm-lock.yaml* web/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile --config.strict-dep-builds=false
COPY web/ ./
RUN pnpm build

FROM golang:1.26-alpine AS go-builder
ENV GOTOOLCHAIN=local
ARG VERSION=0.1.0
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=web-builder /src/web/dist ./web/dist
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X vpspulse/internal/version.Version=${VERSION}" -o /out/vpspulse-hub ./cmd/hub \
 && CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-s -w -X vpspulse/internal/version.Version=${VERSION}" -o /out/vpspulse-agent-linux-amd64 ./cmd/agent \
 && CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -trimpath -ldflags="-s -w -X vpspulse/internal/version.Version=${VERSION}" -o /out/vpspulse-agent-linux-arm64 ./cmd/agent

FROM alpine:3.21
RUN apk add --no-cache ca-certificates iputils tzdata \
 && adduser -D -u 10001 vpspulse \
 && mkdir -p /app/bin /app/data \
 && chown -R vpspulse:vpspulse /app
WORKDIR /app
COPY --from=go-builder /out/vpspulse-hub /usr/local/bin/vpspulse-hub
COPY --from=go-builder /out/vpspulse-agent-linux-amd64 /app/bin/vpspulse-agent-linux-amd64
COPY --from=go-builder /out/vpspulse-agent-linux-arm64 /app/bin/vpspulse-agent-linux-arm64
USER vpspulse
VOLUME ["/app/data"]
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/vpspulse-hub"]
CMD ["--listen", ":8080", "--db", "/app/data/vpspulse.db", "--downloads-dir", "/app/bin"]
