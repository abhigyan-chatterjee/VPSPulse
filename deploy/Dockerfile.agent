FROM golang:1.26-alpine AS builder
ENV GOTOOLCHAIN=local
ARG VERSION=0.1.0
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X vpspulse/internal/version.Version=${VERSION}" -o /out/vpspulse-agent ./cmd/agent

FROM alpine:3.21
RUN apk add --no-cache ca-certificates \
 && adduser -D -u 10001 vpspulse
COPY --from=builder /out/vpspulse-agent /usr/local/bin/vpspulse-agent
USER vpspulse
ENTRYPOINT ["/usr/local/bin/vpspulse-agent"]
