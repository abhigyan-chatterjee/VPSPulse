FROM golang:1.24-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/vpspulse-agent ./cmd/agent

FROM alpine:3.21
RUN apk add --no-cache ca-certificates
COPY --from=builder /out/vpspulse-agent /usr/local/bin/vpspulse-agent
ENTRYPOINT ["/usr/local/bin/vpspulse-agent"]
